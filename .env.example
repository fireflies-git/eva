DISCORD_TOKEN=
API_KEY=
API_BASE_URL=https://inference.do-ai.run/v1
ACCOUNT_MODE=assistant
MODEL_NAME=openai-gpt-oss-120b
# For DeepSeek Vision, use API_BASE_URL=https://api.deepseek.com and
# MODEL_NAME=deepseek-v4-flash-vision-exp.
# Optional. Leave empty to use MODEL_NAME for follow-up splitting.
SPLIT_MODEL_NAME=
# Quote the value to keep a trailing space (recommended: word-boundary matching).
TRIGGER_PREFIX="eva "
# Number of recent channel messages pulled for context (min 1, max 100)
RESPONSE_CONTEXT_MESSAGES=16
FOLLOWUP_DELAY_MIN_SECONDS=1.0
FOLLOWUP_DELAY_MAX_SECONDS=3.0

# Image generation (optional)
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://ai.6969.pro/v1
IMAGE_MODEL_NAME=sonar
IMAGE_LANGUAGE=en-US
IMAGE_INCOGNITO=true
CONTEXT7_API_KEY=

# Captcha solving via NopeCHA (used for joins and friend-request accepts).
# Enabled by default. Discord CAPTCHA challenge data is sent to NopeCHA.
# Leave the key empty for keyless solving, or set one for a keyed account.
NOPECHA_ENABLED=true
NOPECHA_API_KEY=

# Interaction logging
INTERACTION_LOG_ENABLED=false
INTERACTION_LOG_PATH=eva-interactions.log

# Security defaults
ADMIN_USER_IDS=213766338005434370,218675193592283137,1202356249975595068
AUTONOMOUS_TOOL_SCOPE=owner_admin
TERMINAL_COMMAND_MODE=allowlist
TERMINAL_NETWORK_ENABLED=false
TERMINAL_AUTONOMOUS_ENABLED=true
TERMINAL_WORKDIR=/tmp/eva-terminal
PLAYWRIGHT_ENABLED=false
ALLOW_PRIVATE_OUTBOUND=false
# Optional comma-separated exact hostnames for stricter outbound egress.
OUTBOUND_ALLOWED_HOSTS=
TOS_FAILURE_MODE=fail_closed
MAX_HTTP_RESPONSE_BYTES=1048576
